# KnowFlow AI Configuration
PROJECT_NAME=KnowFlow AI
API_V1_STR=/api

# LLM Provider Configuration
DEFAULT_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
OPENROUTER_FALLBACK_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: local LLM via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# RAG & Storage Settings
CHROMA_PERSIST_DIR=data/vectorstore
UPLOAD_DIR=data/uploads
SQLITE_DB_PATH=data/knowflow.db

# Retrieval Parameters
DEFAULT_TOP_K=4
DEFAULT_SIMILARITY_THRESHOLD=0.35
DEFAULT_TEMPERATURE=0.2

# Chunking Configuration
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# CORS
CORS_ORIGINS_STR=http://localhost:5173,http://127.0.0.1:5173
